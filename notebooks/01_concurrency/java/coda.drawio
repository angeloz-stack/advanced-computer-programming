        <mxCell id="ZRm1rRep4JDU7bXdmNCl-19" parent="1" style="whiteSpace=wrap;html=1;shape=mxgraph.basic.rectCallout;dx=30;dy=15;boundedLbl=1;" value="La classe CodeCircolare fornisce l&#39;interfaccia Coda e implementa i metodi, senza però meccanismi di sincronizzazione." vertex="1">
